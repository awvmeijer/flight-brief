{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index?__path=/$1" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "excludeFiles": "{tests/**,docs/**,data/**,.github/**,.claude/**}"
    }
  },
  "regions": ["iad1"]
}
